# Database
DATABASE_URL=postgresql+psycopg://lenny_user:lenny_password@localhost:5432/lenny_growth

# Ollama - required for the local demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT=300

# OpenAI - optional
# Required only when OpenAI is selected in the application
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - optional
# Required only when Claude is selected in the application
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Pi Coding Agent
# Windows users may need to update this path for their local installation.
PI_EXECUTABLE=pi.cmd